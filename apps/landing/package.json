{
  "name": "@changuito/landing",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing landing for www.changuito.me. The shopper app lives in @changuito/web.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev -p 3125",
    "build": "next build",
    "start": "next start -p 3125",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test \"lib/test/*.test.ts\"",
    "dev:vinext": "vite dev --port 3125",
    "build:vinext": "vite build",
    "preview:vinext": "vite preview --host 127.0.0.1 --port 3125",
    "start:vinext": "vinext start",
    "deploy:vinext": "vinext-cloudflare deploy --skip-build"
  },
  "dependencies": {
    "@changuito/trust": "*",
    "@vinext/cloudflare": "1.3.3",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@types/node": "22.10.2",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-rsc": "0.5.39",
    "cf": "1.0.0-beta.28",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  },
  "type": "module"
}
